<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Zea.Tweakr.App">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/Zea.Tweakr.ico" ToolTipText="Zea.Tweakr" Clicked="ShowSettings">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Cài đặt" Click="ShowSettings" />
            <NativeMenuItem Header="Kiểm tra cập nhật" Click="CheckForUpdates" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Click="ExitApp" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
