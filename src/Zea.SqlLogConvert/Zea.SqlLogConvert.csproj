<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TargetFrameworkCommon)</TargetFramework>
    <PublishSelfContained>false</PublishSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.191.0" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <None Include="../Zea.SqlFormat/licenses/ScriptDom.txt" Link="licenses/ScriptDom.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="InitCodegraph.bat" />
  </ItemGroup>

</Project>
