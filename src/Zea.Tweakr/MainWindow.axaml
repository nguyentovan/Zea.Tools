<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notifications="using:Avalonia.Controls.Notifications"
        x:Class="Zea.Tweakr.MainWindow"
        Title="Zea.Tweakr"
        Icon="/Assets/Zea.Tweakr.ico"
        Width="560"
        SizeToContent="Height"
        MinWidth="400"
        WindowStartupLocation="CenterScreen">
  <Panel>
    <StackPanel Margin="28" Spacing="16">
      <TextBlock Text="Cài đặt" FontSize="26" FontWeight="SemiBold" />
      <Border Padding="16" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <StackPanel Spacing="12">
          <CheckBox x:Name="ExplorerTabOption" Content="Tab File Explorer · Win+E" />
          <CheckBox x:Name="SqlFormatOption" Content="Định dạng SQL · Ctrl+K, Ctrl+Y" />
          <CheckBox x:Name="SqlLogConvertOption" Content="Chuyển log thành SQL · Ctrl+K, Ctrl+G" />
          <CheckBox x:Name="StartWithWindowsOption" Content="Khởi động cùng Windows" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="CheckUpdateButton" Margin="0,0,8,0" Click="CheckForUpdates">Kiểm tra cập nhật</Button>
          <Button x:Name="RestartUpdateButton" Classes="accent" IsVisible="False" Click="RestartForUpdate">Cập nhật và khởi động lại</Button>
        </WrapPanel>
        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="HideSettings">Ẩn vào khay</Button>
        <Button Grid.Column="2" VerticalAlignment="Bottom" Classes="accent" Click="SaveSettings">Lưu cài đặt</Button>
      </Grid>
    </StackPanel>
    <notifications:WindowNotificationManager x:Name="SettingsToast" Position="TopRight" MaxItems="1" />
  </Panel>
</Window>
