<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="using:Material3.Avalonia"
             xmlns:notifications="using:Avalonia.Controls.Notifications"
             x:Class="Zea.Tweakr.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/WindowDecorations.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="ToastInformationContainerBrush" Color="#EAF3FF" />
      <SolidColorBrush x:Key="ToastWarningContainerBrush" Color="#FFF6D6" />
      <SolidColorBrush x:Key="ToastErrorContainerBrush" Color="#FDEBEC" />
      <SolidColorBrush x:Key="ToastSuccessContainerBrush" Color="#EAF7EE" />
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="Md3Surface">#FFFFFF</Color>
          <SolidColorBrush x:Key="Md3SurfaceBrush" Color="#FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <material:MaterialTheme SeedColor="#000000" SchemeVariant="Monochrome" />
    <Style Selector="notifications|NotificationCard:information, notifications|NotificationCard:success, notifications|NotificationCard:warning, notifications|NotificationCard:error">
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceBrush}" />
    </Style>
    <Style Selector="notifications|NotificationCard:information /template/ Border#PART_CardBorder, notifications|NotificationCard:success /template/ Border#PART_CardBorder, notifications|NotificationCard:warning /template/ Border#PART_CardBorder, notifications|NotificationCard:error /template/ Border#PART_CardBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource Md3OutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="notifications|NotificationCard:information /template/ Border#PART_CardBorder">
      <Setter Property="Background" Value="{DynamicResource ToastInformationContainerBrush}" />
    </Style>
    <Style Selector="notifications|NotificationCard:warning /template/ Border#PART_CardBorder">
      <Setter Property="Background" Value="{DynamicResource ToastWarningContainerBrush}" />
    </Style>
    <Style Selector="notifications|NotificationCard:error /template/ Border#PART_CardBorder">
      <Setter Property="Background" Value="{DynamicResource ToastErrorContainerBrush}" />
    </Style>
    <Style Selector="notifications|NotificationCard:success /template/ Border#PART_CardBorder">
      <Setter Property="Background" Value="{DynamicResource ToastSuccessContainerBrush}" />
    </Style>
    <Style Selector="notifications|NotificationCard /template/ Button#PART_CloseButton /template/ Path">
      <Setter Property="Fill" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
    </Style>
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/Zea.Tweakr.ico" ToolTipText="Zea.Tweakr" Clicked="ShowSettings">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Cài đặt" Click="ShowSettings" />
            <NativeMenuItem Header="Kiểm tra cập nhật" Click="CheckForUpdates" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Click="ExitApp" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
